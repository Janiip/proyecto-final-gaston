# =========================================================
# Variables de entorno del Sistema de Pañol
# ---------------------------------------------------------
# 1. Copiá este archivo y renombralo a ".env"
# 2. Completá tus datos reales en el ".env"
# 3. El ".env" NO se sube a Git (está en .gitignore)
# =========================================================

# --- Base de datos (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=panol_escuela
DB_USUARIO=root
DB_CLAVE=

# --- Correo (SMTP) para los avisos ---
# Con Gmail hay que usar una "contraseña de aplicación",
# no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=correo.del.panol@gmail.com
SMTP_CLAVE=poner_aca_la_clave_de_aplicacion
SMTP_NOMBRE_REMITENTE="Pañol EEST N°1"

# --- General ---
ZONA_HORARIA=America/Argentina/Buenos_Aires
